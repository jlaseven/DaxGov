aws_region            = "ap-southeast-1"
name                  = "daxgov"
environment           = "sandbox"
vpc_cidr              = "10.82.0.0/16"
database_name         = "daxgov"
database_username     = "daxgov"
aurora_engine_version = "16.8"
aurora_min_acu        = 0.5
aurora_max_acu        = 4
desired_count         = 1
image_tag             = "latest"
# Leave domain_name empty to use the CloudFront default hostname (no Route 53 / ACM).
domain_name           = ""
# domain_name         = "daxgov.example.com"
# route53_zone_id     = "ZXXXXXXXXXXXX"
# certificate_arn     = "arn:aws:acm:ap-southeast-1:123456789012:certificate/..."
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# allowed_ingress_cidrs = ["10.80.0.0/16"]

